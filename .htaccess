<IfModule mod_rewrite.c>
    RewriteEngine On

    # Chặn truy cập trực tiếp các thư mục mã nguồn và dữ liệu nhạy cảm
    RewriteRule ^(app|database|storage|cron|docs|\.git)(\/.*)?$ - [F,L,NC]
    RewriteRule ^(\.env.*|composer\..*|package.*)$ - [F,L,NC]

    # Điều hướng root và các request hợp lệ về thư mục public
    RewriteRule ^$ public/ [L]
    RewriteCond %{REQUEST_URI} !public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# Chặn tuyệt đối truy cập file cấu hình, nhật ký và tài liệu nhạy cảm
<FilesMatch "(^\.env|\.git|\.sql|\.log|\.md|\.json|\.yml|\.yaml|\.lock)$">
    Require all denied
</FilesMatch>
