# -----------------------------------------------------------------------------
# HP-eGov: Hệ thống Một cửa điện tử liên thông TP. Hải Phòng
# Cấu hình môi trường (.env)
# -----------------------------------------------------------------------------

# Cấu hình ứng dụng
APP_NAME=HP-eGov
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost/HP-eGov
APP_TIMEZONE=Asia/Ho_Chi_Minh
APP_LOCALE=vi
APP_KEY=hp-egov-secret-key-32-chars-long!!2026

# Cơ sở dữ liệu ghi chính (Master Write)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hp_egov
DB_USERNAME=root
DB_PASSWORD=

# Cơ sở dữ liệu đọc (Replica Read) - để trống nếu dùng chung Master
DB_READ_HOST=
DB_READ_PORT=3306
DB_READ_DATABASE=hp_egov
DB_READ_USERNAME=root
DB_READ_PASSWORD=

# Chế độ tích hợp (mock: giả lập nội bộ | live: kết nối trục thật)
INTEGRATION_MODE=mock

# Phiên làm việc (Session) & Cookie an toàn
SESSION_LIFETIME=1800
SESSION_SECURE_COOKIE=false
SESSION_COOKIE_NAME=hpegov_session

# Bảo mật & Giới hạn truy cập (Rate Limit)
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW=60

# Chuẩn kỹ thuật hành chính
MA_TINH_QCVN102=H21
SLA_WARNING_PERCENT=75
SLA_CRITICAL_HOURS=24
